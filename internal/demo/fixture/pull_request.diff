diff --git a/internal/gateway/retry.go b/internal/gateway/retry.go
new file mode 100644
index 0000000..a7c8f3f
--- /dev/null
+++ b/internal/gateway/retry.go
@@ -0,0 +1,74 @@
+package gateway
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"time"
+)
+
+// Policy retries a call that failed with a retryable error.
+//
+// The delay doubles after every attempt, starting at BaseDelay. A Policy is
+// safe for concurrent use; Attempts reports on the most recent call to Do.
+type Policy struct {
+	// MaxAttempts is the total number of tries, including the first.
+	MaxAttempts int
+	// BaseDelay is the wait before the second attempt.
+	BaseDelay time.Duration
+	// Sleep waits for d or until ctx is done. Tests replace it.
+	Sleep func(ctx context.Context, d time.Duration) error
+
+	mu       sync.Mutex
+	attempts int
+}
+
+// DefaultPolicy is the policy used in production: three attempts, the
+// second one 200ms after the first.
+func DefaultPolicy() *Policy {
+	return &Policy{MaxAttempts: 3, BaseDelay: 200 * time.Millisecond, Sleep: sleep}
+}
+
+// Do calls fn until it succeeds, returns an error that is not retryable,
+// runs out of attempts, or ctx is done. fn receives the attempt number,
+// starting at 1.
+//
+// The error from the last attempt is returned unchanged.
+func (p *Policy) Do(ctx context.Context, fn func(attempt int) error) error {
+	var err error
+	delay := p.BaseDelay
+	for attempt := 1; attempt <= p.MaxAttempts; attempt++ {
+		p.mu.Lock()
+		p.attempts = attempt
+		p.mu.Unlock()
+
+		if err = fn(attempt); err == nil || !IsRetryable(err) {
+			return err
+		}
+		if attempt == p.MaxAttempts {
+			break
+		}
+		if sleepErr := p.Sleep(ctx, delay); sleepErr != nil {
+			return errors.Join(err, sleepErr)
+		}
+		delay *= 2
+	}
+	return err
+}
+
+// Attempts returns how many times the most recent Do called its function.
+func (p *Policy) Attempts() int {
+	return p.attempts
+}
+
+// sleep is the production Sleep: it waits for d unless ctx ends first.
+func sleep(ctx context.Context, d time.Duration) error {
+	t := time.NewTimer(d)
+	defer t.Stop()
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-t.C:
+		return nil
+	}
+}
diff --git a/internal/gateway/retry_test.go b/internal/gateway/retry_test.go
new file mode 100644
index 0000000..ff102cb
--- /dev/null
+++ b/internal/gateway/retry_test.go
@@ -0,0 +1,112 @@
+package gateway
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+)
+
+// recordingSleep collects the delays a Policy asked for without waiting.
+type recordingSleep struct {
+	delays []time.Duration
+	err    error
+}
+
+func (r *recordingSleep) sleep(_ context.Context, d time.Duration) error {
+	r.delays = append(r.delays, d)
+	return r.err
+}
+
+func newTestPolicy(max int) (*Policy, *recordingSleep) {
+	rec := &recordingSleep{}
+	return &Policy{MaxAttempts: max, BaseDelay: 200 * time.Millisecond, Sleep: rec.sleep}, rec
+}
+
+func TestPolicyDo(t *testing.T) {
+	errBoom := errors.New("boom")
+
+	tests := []struct {
+		name         string
+		results      []error
+		wantErr      error
+		wantAttempts int
+		wantDelays   []time.Duration
+	}{
+		{
+			name:         "succeeds first time",
+			results:      []error{nil},
+			wantAttempts: 1,
+		},
+		{
+			name:         "retries a timeout and then succeeds",
+			results:      []error{retryable(ErrGatewayTimeout), nil},
+			wantAttempts: 2,
+			wantDelays:   []time.Duration{200 * time.Millisecond},
+		},
+		{
+			name:         "doubles the delay between attempts",
+			results:      []error{retryable(ErrGatewayTimeout), retryable(ErrGatewayTimeout), nil},
+			wantAttempts: 3,
+			wantDelays:   []time.Duration{200 * time.Millisecond, 400 * time.Millisecond},
+		},
+		{
+			name:         "gives up after the last attempt",
+			results:      []error{retryable(ErrGatewayTimeout), retryable(ErrGatewayTimeout), retryable(ErrGatewayTimeout)},
+			wantErr:      ErrGatewayTimeout,
+			wantAttempts: 3,
+			wantDelays:   []time.Duration{200 * time.Millisecond, 400 * time.Millisecond},
+		},
+		{
+			name:         "does not retry other errors",
+			results:      []error{errBoom},
+			wantErr:      errBoom,
+			wantAttempts: 1,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			policy, rec := newTestPolicy(3)
+
+			err := policy.Do(context.Background(), func(attempt int) error {
+				return tt.results[attempt-1]
+			})
+
+			if !errors.Is(err, tt.wantErr) {
+				t.Errorf("Do() error = %v, want %v", err, tt.wantErr)
+			}
+			if got := policy.Attempts(); got != tt.wantAttempts {
+				t.Errorf("Attempts() = %d, want %d", got, tt.wantAttempts)
+			}
+			if len(rec.delays) != len(tt.wantDelays) {
+				t.Fatalf("slept %d times, want %d", len(rec.delays), len(tt.wantDelays))
+			}
+			for i, d := range rec.delays {
+				if d != tt.wantDelays[i] {
+					t.Errorf("delay %d = %v, want %v", i, d, tt.wantDelays[i])
+				}
+			}
+		})
+	}
+}
+
+// A cancelled context must end the retries at once, and the caller should
+// still be able to see why the last attempt failed.
+func TestPolicyDoStopsWhenContextEnds(t *testing.T) {
+	policy, rec := newTestPolicy(3)
+	rec.err = context.Canceled
+
+	calls := 0
+	err := policy.Do(context.Background(), func(int) error {
+		calls++
+		return retryable(ErrGatewayTimeout)
+	})
+
+	if calls != 1 || !errors.Is(err, context.Canceled) {
+		t.Errorf("called fn %d times with error %v, want 1 call and context.Canceled", calls, err)
+	}
+	if !errors.Is(err, ErrGatewayTimeout) {
+		t.Errorf("Do() error = %v, want it to keep the timeout as well", err)
+	}
+}
